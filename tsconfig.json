{
  "extends": "astro/tsconfigs/strictest",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  },
  "include": [
    ".astro/types.d.ts",
    "src/**/*",
    "scripts/**/*",
    "tests/e2e/**/*",
    "tests/unit/lib/**/*",
    "*.config.ts"
  ],
  "exclude": ["dist", "node_modules", "worker", "tests/unit/worker"]
}
