---
// ARNAV-OS boot (SPEC row 0): a transformer forward pass on one canvas (src/lib/transformer.ts) that decodes
// the name and hands it to the hero. Shown only while <html data-boot> is set (inline head script in
// Base.astro). Decorative, so aria-hidden: the page underneath stays readable to screen readers throughout.
import { site } from '../../lib/content';
---

<div class="boot" data-boot-overlay data-content={JSON.stringify(site.boot)} aria-hidden="true">
  <canvas class="boot__canvas"></canvas>
  <p class="boot__hint hud">press any key to skip</p>
</div>

<style>
  .boot {
    display: none;
  }
  :global(:root[data-boot]) .boot {
    position: fixed;
    inset: 0;
    z-index: var(--z-toast);
    display: block;
    background: var(--bg);
  }
  :global(:root[data-boot='on']) {
    overflow: hidden;
  }
  /* Hand-off: the page shows through while the decoded letters fly into the hero name. */
  :global(:root[data-boot='out']) .boot {
    pointer-events: none;
    background: transparent;
    transition: background-color 450ms var(--ease-out);
  }
  :global(:root[data-boot='skip']) .boot {
    pointer-events: none;
    opacity: 0;
    transition: opacity 250ms var(--ease-out);
  }
  .boot__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .boot__hint {
    position: absolute;
    right: var(--space-5);
    bottom: var(--space-5);
    color: var(--text-2);
    opacity: 0;
    animation: fade-in 300ms var(--ease-out) 500ms forwards;
  }
  :global(:root[data-boot='out']) .boot__hint {
    display: none;
  }
  @keyframes fade-in {
    to {
      opacity: 1;
    }
  }
</style>
