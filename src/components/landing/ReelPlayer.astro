---
// Full-screen reel player styles (SPEC "75 Hard": click a card → full-screen player with sound, swipe or arrows
// for next). The dialog itself is built by src/lib/reels.ts (playerMarkup) when the page loads: it only works
// with JavaScript, and keeping it out of the HTML keeps the document under the ~14 KB first-flight budget
// (mistakes.md, 1.5cd). Because that markup is created in the browser, these styles are global; every class is
// prefixed `player`.
---

<style is:global>
  .player {
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    color: var(--text);
    backdrop-filter: blur(10px);
  }
  .player:not([open]) {
    display: none;
  }
  .player::backdrop {
    background: color-mix(in srgb, var(--bg) 70%, transparent);
  }
  .player__frame {
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto auto;
    justify-items: center;
    gap: var(--space-3);
    height: 100%;
    padding: var(--space-4);
  }
  .player__stage {
    position: relative;
    /* A 9:16 box sized from the viewport height minus the status line and controls, so it hugs the clip */
    width: min(100%, calc((100dvh - 140px) * 9 / 16));
    max-height: 100%;
    aspect-ratio: 9 / 16;
    overflow: hidden;
    border: var(--border);
    border-radius: var(--radius-card);
    background: var(--surface);
    /* Horizontal swipes belong to the player; vertical gestures stay with the browser */
    touch-action: pan-y;
  }
  .player__video {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .player__load {
    position: absolute;
    inset: auto 0 0;
    display: grid;
    gap: var(--space-2);
    padding: var(--space-5) var(--space-4) var(--space-4);
    background: linear-gradient(
      to top,
      color-mix(in srgb, var(--bg) 90%, transparent),
      transparent
    );
  }
  .player__load[hidden] {
    display: none;
  }
  .player__bar {
    height: 2px;
    border-radius: var(--radius-pill);
    background: var(--line);
    overflow: hidden;
  }
  .player__bar::after {
    content: '';
    display: block;
    height: 100%;
    background: var(--time);
    transform: scaleX(var(--load, 0));
    transform-origin: left;
    transition: transform var(--dur-hover) linear;
  }
  .player__status {
    color: var(--text-2);
    text-align: center;
  }
  .player__controls {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
  }
  .player__ico {
    display: none;
    line-height: 0;
  }
  [data-state='playing'] .player__ico--pause,
  [data-state='paused'] .player__ico--play,
  [data-state='sound'] .player__ico--sound,
  [data-state='muted'] .player__ico--muted {
    display: inline-flex;
  }
  html:has(.player[open]) {
    overflow: hidden;
  }
</style>
