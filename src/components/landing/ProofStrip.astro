---
// Proof strip (SPEC row 3): real numbers from site.json. A slow CSS marquee that pauses on hover and focus;
// static with reduced motion; a 2-column grid below 768 px. The second copy exists only to loop seamlessly.
import { site } from '../../lib/content';
---

<section class="proof" aria-labelledby="proof-title">
  <h2 id="proof-title" class="visually-hidden">
    Results in numbers
  </h2>
  <div class="proof__viewport">
    <div class="proof__track">
      {[false, true].map((copy) => (
        <ul class="proof__list" aria-hidden={copy || undefined} data-copy={copy || undefined}>
          {site.proof.map((p) => (
            <li class="proof__item">
              <span class="proof__value">{p.value}</span>
              <span class="hud proof__label">{p.label}</span>
            </li>
          ))}
        </ul>
      ))}
    </div>
  </div>
</section>

<style>
  .proof {
    border-block: var(--border);
  }
  .proof__viewport {
    overflow: hidden;
  }
  .proof__track {
    display: grid;
  }
  .proof__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-5) var(--space-4);
    padding: var(--space-6) var(--space-4);
    list-style: none;
  }
  .proof__list[data-copy] {
    display: none;
  }
  .proof__item {
    display: grid;
    gap: var(--space-1);
  }
  .proof__value {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--type-heading);
    line-height: var(--lh-heading);
  }
  .proof__label {
    color: var(--text-2);
  }

  @media (min-width: 768px) {
    .proof__track {
      display: flex;
      width: max-content;
      animation: marquee 40s linear infinite;
    }
    .proof__viewport:hover .proof__track,
    .proof__viewport:focus-within .proof__track {
      animation-play-state: paused;
    }
    .proof__list,
    .proof__list[data-copy] {
      display: flex;
      flex: none;
      justify-content: space-around;
      gap: var(--space-9);
      min-width: 100vw;
      padding: var(--space-6) var(--space-9) var(--space-6) 0;
    }
    .proof__item {
      grid-auto-flow: column;
      align-items: baseline;
      gap: var(--space-3);
      white-space: nowrap;
    }
    /* Reduced motion: one static row, no duplicate */
    :global(:root[data-motion='reduced']) .proof__track {
      width: auto;
      animation: none;
    }
    :global(:root[data-motion='reduced']) .proof__list {
      flex-wrap: wrap;
      justify-content: center;
      gap: var(--space-5) var(--space-8);
      min-width: 0;
      width: 100%;
      padding-inline: var(--space-6);
    }
    :global(:root[data-motion='reduced']) .proof__list[data-copy] {
      display: none;
    }
  }
  @keyframes marquee {
    to {
      transform: translateX(-50%);
    }
  }
</style>
