---
import Base from '../layouts/Base.astro';
import Boot from '../components/landing/Boot.astro';
import Nav from '../components/landing/Nav.astro';
import Hero from '../components/landing/Hero.astro';
import ProofStrip from '../components/landing/ProofStrip.astro';
import SelectedWork from '../components/landing/SelectedWork.astro';
import AllProjects from '../components/landing/AllProjects.astro';
import Experience from '../components/landing/Experience.astro';
import Hard75 from '../components/landing/Hard75.astro';
import Skills from '../components/landing/Skills.astro';
import BeyondCode from '../components/landing/BeyondCode.astro';
import ReelPlayer from '../components/landing/ReelPlayer.astro';
import { site } from '../lib/content';

// Nav targets that task 1.5d fills in; stubs keep every anchor resolving until then.
const upcoming = [
  ['freelance', 'Open to freelance'],
  ['contact', 'Contact'],
] as const;
---

<Base title={`${site.name} · ${site.roleLine}`} boot>
  <Nav slot="nav" />
  <Boot />
  <main id="main">
    <Hero />
    <ProofStrip />
    <SelectedWork />
    <AllProjects />
    <Experience />
    <Hard75 />
    <Skills />
    {upcoming.map(([id, title]) => (
      <section id={id} class="stub" aria-labelledby={`${id}-title`}>
        <h2 id={`${id}-title`} class="display">
          {title}
        </h2>
        <p class="small">Arrives in task 1.5c–1.5d.</p>
      </section>
    ))}
    <BeyondCode />
  </main>
  <ReelPlayer />
</Base>

<script>
  import { initBoot } from '../lib/boot';
  import { initNav } from '../lib/nav';
  import { initHero } from '../lib/hero';
  import { initWork } from '../lib/work';
  import { initExperience } from '../lib/experience';
  import { initReels } from '../lib/reels';
  import { initDock } from '../lib/dock';
  import { initTilt } from '../lib/tilt';

  initBoot();
  initNav();
  initHero();
  initWork();
  initExperience();
  initReels();
  initDock();
  initTilt();
</script>

<style>
  .stub {
    display: grid;
    gap: var(--space-3);
    width: min(100%, 1280px);
    margin-inline: auto;
    padding: var(--section-gap) var(--space-4) 0;
    scroll-margin-top: 60px;
  }
  .stub:last-child {
    padding-bottom: var(--section-gap);
  }
  @media (min-width: 768px) {
    .stub {
      padding-inline: var(--space-6);
    }
  }
</style>
