---
// /workshop: the 3D room (Phase 2b, task 2.4) over a server-rendered HUD zone list. The list is the page without
// JavaScript, on devices without WebGL and while a phone has not said "try anyway"; with the room running it is replaced
// by the HUD's own list (src/components/workshop/Hud.tsx). The room's code (three.js and all) is imported only when the
// room is allowed to start, so the landing page and this page's first paint carry none of it. Copy comes from content/site.json.
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { site } from '../lib/content';

const w = site.workshop;
---

<Base title={`${w.title} · ${site.name}`} description={w.lead} workshop>
  {/* Runs while the page is parsed, before the first paint: marks an arrival from the entry sequence (see enter-sequence.ts). */}
  <script is:inline>
    try {
      if (sessionStorage.getItem('arnav:arrive')) {
        sessionStorage.removeItem('arnav:arrive');
        document.documentElement.dataset.arrive = '';
      }
    } catch {
      // Storage blocked: the page opens without the arrival fade.
    }
  </script>
  {/* Desktop with JavaScript: hide the list from the first paint, so it does not flash before the room's loader. A failsafe restores it. */}
  <script is:inline>
    (() => {
      const d = document.documentElement;
      if (innerWidth < 768) return;
      d.dataset.room = 'loading';
      setTimeout(() => {
        if (d.dataset.room === 'loading') delete d.dataset.room;
      }, 20000);
    })();
  </script>
  <main id="main" class="ws">
    <div id="room-root"></div>
    <a class="ws__back hud" href="/">
      <Icon name="chevron-left" size={16} /> Back to the site
    </a>

    <header class="ws__head">
      <p class="hud ws__status">
        <span class="ws__dot" aria-hidden="true"></span>
        {w.status}
      </p>
      <h1 class="display">{w.title}</h1>
      <p class="ws__lead">{w.lead}</p>
    </header>

    <p class="small ws__reply" data-room-fail role="status" hidden>
      {w.room.unavailable}
    </p>

    <aside class="ws__note" data-mobile-note aria-label="Device note">
      <p>{w.note}</p>
      <button class="button button--ghost" type="button" data-try>
        {w.tryAnyway}
      </button>
      <p class="small ws__reply" data-try-reply role="status" hidden>
        {w.tryAnywayReply}
      </p>
    </aside>

    <section aria-labelledby="zones-title">
      <h2 id="zones-title" class="hud ws__label">
        {w.zonesLabel}
      </h2>
      <ul class="ws__zones">
        {w.zones.map((z, i) => (
          <li style={`--i: ${i}`}>
            <a class="zone" href={z.href}>
              <span class="hud zone__n" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <span class="zone__title">{z.title}</span>
              <span class="small zone__blurb">{z.blurb}</span>
              <Icon name="arrow-up-right" size={18} />
            </a>
          </li>
        ))}
      </ul>
    </section>
  </main>
</Base>

<script
  is:inline
  type="application/json"
  id="room-data"
  set:html={JSON.stringify({ room: { ...w.room, title: w.title }, zones: w.zones })}
/>
<script>
  import { mountLoader } from '../lib/loader';

  // Starts the room: desktop at once, a phone once the visitor says "try anyway". Anything that goes wrong (no WebGL, a
  // failed import, an error in the scene) puts the HUD zone list back with a plain note.
  const doc = document.documentElement;
  const dataEl = document.getElementById('room-data');
  const root = document.getElementById('room-root');
  const button = document.querySelector<HTMLButtonElement>('[data-try]');
  const reply = document.querySelector<HTMLElement>('[data-try-reply]');
  const failNote = document.querySelector<HTMLElement>('[data-room-fail]');
  let started = false;

  const hasWebGl = (): boolean => {
    try {
      const canvas = document.createElement('canvas');
      return Boolean(canvas.getContext('webgl2') ?? canvas.getContext('webgl'));
    } catch {
      return false;
    }
  };

  async function start(): Promise<void> {
    if (started || !dataEl?.textContent || !root) return;
    started = true;
    const data = JSON.parse(dataEl.textContent) as {
      room: { loading: string };
      zones: unknown[];
    };
    const fail = (shown?: ReturnType<typeof mountLoader>): void => {
      shown?.remove();
      doc.dataset['room'] = 'off';
      if (failNote) failNote.hidden = false;
    };
    if (!hasWebGl()) return fail();
    doc.dataset['room'] = 'loading';
    const loader = mountLoader({ label: `${data.room.loading} · 0%`, progress: 0 });
    const label = loader.el.querySelector('.ld__label');
    try {
      const { mountRoom } = await import('../components/workshop/mount');
      mountRoom(root, data as Parameters<typeof mountRoom>[1], {
        onProgress(ratio) {
          loader.set(ratio);
          if (label) label.textContent = `${data.room.loading} · ${Math.round(ratio * 100)}%`;
        },
        onReady() {
          doc.dataset['room'] = 'on';
          loader.remove();
        },
        onFail: () => fail(loader),
      });
    } catch {
      fail(loader);
    }
  }

  // "Try anyway" on a phone opens the room on this device.
  button?.addEventListener('click', () => {
    if (reply) reply.hidden = false;
    button.hidden = true;
    void start();
  });
  // Arriving from the entry sequence, the page rises out of the page colour over 1.2 s. Starting the room (which keeps the
  // main thread busy while it builds its textures) in the middle of that would make the rise stutter, so it waits for it.
  const arriving = document.documentElement.hasAttribute('data-arrive');
  if (innerWidth >= 768) setTimeout(() => void start(), arriving ? 1300 : 0);
</script>

<style>
  /* Arriving from the entry sequence: the page rises out of the page colour instead of cutting in. */
  :global(html[data-arrive] body)::before {
    content: '';
    position: fixed;
    inset: 0;
    z-index: 1200;
    background: var(--bg);
    pointer-events: none;
    animation: ws-arrive 1200ms var(--ease-out) forwards;
  }
  @keyframes ws-arrive {
    0%,
    30% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      visibility: hidden;
    }
  }
  /* While the room loads the list stays out of sight; with the room on, only the room is shown. */
  :global(html[data-room='loading'] .ws > :not(#room-root)) {
    visibility: hidden;
  }
  /* The page's heading stays available to screen readers throughout the load (the room brings its own once it is on). */
  :global(html[data-room='loading'] .ws__head h1) {
    visibility: visible;
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  :global(html[data-room='on'] .ws > :not(#room-root)) {
    display: none;
  }
  :global(html[data-room='on']),
  :global(html[data-room='on'] body) {
    overflow: hidden;
  }
  :global(html[data-room='on'] .ws) {
    display: block;
    width: 100%;
    padding: 0;
  }
  .ws {
    display: grid;
    gap: var(--space-6);
    width: min(100%, 1100px);
    margin-inline: auto;
    padding: calc(var(--space-9) + var(--space-3)) var(--space-4) var(--space-9);
  }
  .ws__back {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    justify-self: start;
    min-height: 44px;
    color: var(--text-2);
    text-decoration: none;
  }
  .ws__back:hover {
    color: var(--time);
  }
  .ws__head {
    display: grid;
    gap: var(--space-3);
  }
  .ws__status {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--time);
  }
  .ws__dot {
    width: 8px;
    height: 8px;
    border-radius: var(--radius-pill);
    background: var(--time);
    animation: ws-pulse 2.4s var(--ease-out) infinite;
  }
  @keyframes ws-pulse {
    from {
      box-shadow: 0 0 0 0 color-mix(in srgb, var(--time) 55%, transparent);
    }
    to {
      box-shadow: 0 0 0 10px transparent;
    }
  }
  .ws__lead {
    max-width: 60ch;
    color: var(--text-2);
  }
  /* The device note only matters on a phone */
  .ws__note {
    display: none;
    gap: var(--space-3);
    padding: var(--space-4);
    border: 1px solid color-mix(in srgb, var(--time) 45%, var(--line));
    border-radius: var(--radius-card);
    background: var(--surface);
  }
  .ws__note .button {
    justify-self: start;
  }
  /* .button sets display, which would otherwise beat the hidden attribute */
  .ws__note :global([hidden]) {
    display: none;
  }
  @media (max-width: 767px) {
    .ws__note {
      display: grid;
    }
  }
  .ws__label {
    margin-bottom: var(--space-4);
    color: var(--text-2);
  }
  .ws__zones {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .ws__zones li {
    animation: ws-in var(--dur-reveal) var(--ease-out) both;
    animation-delay: calc(var(--i) * var(--stagger));
  }
  :global(:root[data-motion='reduced']) .ws__zones li {
    animation: none;
  }
  @keyframes ws-in {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }
  .zone {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr auto;
    grid-template-areas:
      'n title icon'
      'n blurb icon';
    column-gap: var(--space-4);
    row-gap: var(--space-1);
    align-items: center;
    padding: var(--space-4);
    border: var(--border);
    border-radius: var(--radius-card);
    background: var(--surface);
    color: var(--text);
    text-decoration: none;
    overflow: hidden;
    transition:
      border-color var(--dur-hover) var(--ease-out),
      transform var(--dur-hover) var(--ease-out);
  }
  /* A bar of the accent grows up the left edge on hover or focus */
  .zone::before {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    width: 3px;
    background: var(--time);
    transform: scaleY(0);
    transition: transform 320ms var(--ease-out);
  }
  .zone:hover,
  .zone:focus-visible {
    border-color: color-mix(in srgb, var(--time) 55%, var(--line));
    transform: translateX(4px);
  }
  .zone:hover::before,
  .zone:focus-visible::before {
    transform: scaleY(1);
  }
  .zone__n {
    grid-area: n;
    color: var(--time);
  }
  .zone__title {
    grid-area: title;
    font-weight: 600;
    font-size: var(--type-heading);
    line-height: 1.25;
  }
  .zone__blurb {
    grid-area: blurb;
    color: var(--text-2);
  }
  .zone :global(.icon) {
    grid-area: icon;
    color: var(--text-2);
  }
  @media (min-width: 768px) {
    .ws {
      padding-inline: var(--space-6);
    }
    .ws__zones {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
