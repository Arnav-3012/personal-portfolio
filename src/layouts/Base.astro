---
import { Font } from 'astro:assets';
import '../styles/global.css';
import SettingsPanel from '../components/SettingsPanel.astro';
import Toaster from '../components/Toaster.astro';
import ProgressBar from '../components/ProgressBar.astro';
import WorkshopTheme from '../components/WorkshopTheme.astro';
import { SETTINGS_KEY } from '../lib/settings';
import { BOOT_KEY, FAILSAFE_MS } from '../lib/boot';
import { site } from '../lib/content';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  /** Plays the ARNAV-OS boot (landing only). */
  boot?: boolean;
  /** The 3D workshop: Auto theme follows Mumbai time instead of the OS setting (SPEC "Theme switching"). */
  workshop?: boolean;
  /** Loads the era font (Fraunces italic, retro-TV titles only). Off by default: its @font-face block is HTML bytes. */
  era?: boolean;
}
const {
  title,
  description = `${site.name}: ${site.roleLine}.`,
  noindex = false,
  boot = false,
  workshop = false,
  era = false,
} = Astro.props;
const hasNav = Astro.slots.has('nav');
---

<!doctype html>
<html lang="en" data-auto={workshop ? 'mumbai' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
    {/* Sets theme + motion before first paint so there is no flash. Mirrors src/lib/theme.ts. */}
    <script
      is:inline
      define:vars={{ key: SETTINGS_KEY, boot, bootKey: BOOT_KEY, failsafe: FAILSAFE_MS }}
    >
      (() => {
        const d = document.documentElement;
        d.dataset.js = '';
        let s = {};
        try {
          s = JSON.parse(localStorage.getItem(key) || '{}') || {};
        } catch {
          // Storage blocked: fall back to the OS preferences below.
        }
        const m = (q) => matchMedia(q).matches;
        d.dataset.theme =
          s.theme === 'day' || s.theme === 'night'
            ? s.theme
            : m('(prefers-color-scheme: dark)')
              ? 'night'
              : 'day';
        d.dataset.motion =
          s.motion === 'reduced' || (s.motion !== 'full' && m('(prefers-reduced-motion: reduce)'))
            ? 'reduced'
            : 'full';
        // ARNAV-OS boot: once per session, never with reduced motion (mirrors shouldBoot in src/lib/boot.ts).
        // The timeout is a failsafe so the page can never stay covered if the module script fails to load.
        if (boot && d.dataset.motion === 'full') {
          let seen = false;
          try {
            seen = sessionStorage.getItem(bootKey) === 'seen';
          } catch {
            // Storage blocked: show the boot.
          }
          if (!seen) {
            d.dataset.boot = 'on';
            setTimeout(() => {
              if (d.dataset.boot === 'on') delete d.dataset.boot;
            }, failsafe);
          }
        }
      })();
    </script>
    {workshop && <WorkshopTheme />}
    <Font cssVariable="--font-display" preload={[{ weight: 700 }]} />
    <Font cssVariable="--font-body" preload={[{ weight: 400 }]} />
    <Font cssVariable="--font-mono" />
    {era && <Font cssVariable="--font-era" />}
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <ProgressBar />
    <header
      class:list={['shell-bar', { 'shell-bar--nav': hasNav }]}
      data-nav-bar={hasNav || undefined}
    >
      <slot name="nav" />
      <SettingsPanel />
    </header>
    <slot />
    <Toaster />
    <script>
      import { initTheme } from '../lib/theme';
      import { audio } from '../lib/audio';
      import { initRouteLoader } from '../lib/route-loader';

      initTheme();
      audio();
      initRouteLoader();
    </script>
  </body>
</html>

<style>
  .shell-bar {
    position: fixed;
    top: var(--space-4);
    right: var(--space-4);
    z-index: var(--z-progress);
    display: flex;
    gap: var(--space-2);
  }
  /* With a nav: a full-width sticky bar that slides away on scroll down (src/lib/nav.ts). */
  .shell-bar--nav {
    top: 0;
    right: 0;
    left: 0;
    /* Under the progress bar and the page-transition curtain */
    z-index: calc(var(--z-progress) - 2);
    align-items: stretch;
    gap: 0;
    height: 56px;
    border-bottom: 1px solid color-mix(in srgb, var(--time) 35%, var(--line));
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(12px);
    transition: transform 300ms var(--ease-out);
  }
  /* Icon buttons (settings gear, menu) become square cells of the HUD bar. */
  .shell-bar--nav > :global(.icon-button) {
    width: 56px;
    height: auto;
    border: 0;
    border-left: var(--border);
    border-radius: 0;
    background: transparent;
  }
  .shell-bar--nav > :global(.icon-button:hover) {
    color: var(--time);
  }
  .shell-bar--nav[data-hidden]:not(:focus-within) {
    transform: translateY(-100%);
  }
</style>
