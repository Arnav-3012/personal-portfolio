{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "arnav-portfolio",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // Astro builds the static site into ./dist. The Worker only runs first for the API and admin.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/admin*"],
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
  },
  // IDs are omitted on purpose: local dev needs none, and Wrangler provisions them on first deploy (task 1.10).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "portfolio",
      "migrations_dir": "migrations",
      "database_id": "84b3431d-7952-4af5-8b72-54273745703a",
    },
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "a00e7809d315410cb304597608d7a276",
    },
  ],
  // Vectorize has no local mode, so the binding is remote. The index (768 dims, cosine) was created in task 1.8.
  "vectorize": [
    {
      "binding": "VECTORIZE",
      "index_name": "edith-kb",
      "remote": true,
    },
  ],
  // Workers AI always runs remotely, so `wrangler dev` needs `wrangler login`. `wrangler dev --local` skips it (AI unavailable).
  "ai": {
    "binding": "AI",
  },
  // Must be a verified Email Routing destination: arnavc.work@gmail.com is the one verified in the dashboard (2026-10-19).
  "send_email": [
    {
      "name": "EMAIL",
      "destination_address": "arnavc.work@gmail.com",
    },
  ],
  // MAIL_TO must equal the send_email destination above (a restricted binding only delivers there).
  // MAIL_FROM must be an address on the domain whose Email Routing is enabled (task 1.10).
  // ADMIN_EMAILS: the only identities /admin accepts from Access (both are Arnav's; Access itself also restricts).
  "vars": {
    "MAIL_FROM": "portfolio@arnavc.in",
    "MAIL_TO": "arnavc.work@gmail.com",
    "ADMIN_EMAILS": "arnavworkmail3012@gmail.com,arnavc.work@gmail.com",
  },
  // The site on Arnav's own domain, alongside the workers.dev address: one Worker answers both, so one deploy updates both.
  // arnavc.in is active in Cloudflare. www.arnavc.in is attached in the dashboard (Workers & Pages > arnav-portfolio >
  // Settings > Domains & Routes > Add > Custom domain), not here: a DNS record already exists for it, and a config
  // deploy fails part-way if that record conflicts.
  // workers_dev must be stated: once `routes` exists Wrangler turns the workers.dev address off by default, and that is the
  // link Arnav submits with. Only the apex is attached on purpose: Arnav does not need www.arnavc.in (2026-10-19).
  "workers_dev": true,
  "routes": [{ "pattern": "arnavc.in", "custom_domain": true }],
  "observability": {
    "enabled": true,
  },
  // worker/cron.ts dispatches on these exact strings. The free plan allows five cron triggers per account.
  "triggers": {
    "crons": ["0 */6 * * *", "*/30 * * * *"],
  },
  // Secrets (wrangler secret put, or .dev.vars locally): TURNSTILE_SECRET, GITHUB_TOKEN. Task 1.10 also sets the
  // ACCESS_TEAM_DOMAIN and ACCESS_AUD vars for /admin. All typed in worker/secrets.d.ts.
}
