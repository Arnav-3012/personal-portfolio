{
  "name": "arnav-portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/check-html-budget.ts",
    "preview": "pnpm build && wrangler dev",
    "typecheck": "astro check && tsc -p worker",
    "lint": "eslint . && node scripts/check-no-hex.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "e2e": "playwright test",
    "links": "linkinator ./dist --recurse --config .linkinator.config.json",
    "lhci": "lhci autorun",
    "cf-typegen": "wrangler types",
    "kb:build": "node scripts/kb-build.ts"
  },
  "dependencies": {
    "@astrojs/react": "7.1.0",
    "astro": "7.4.0",
    "hono": "4.13.13",
    "lenis": "^1.3.27",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.14.0",
    "@cloudflare/vitest-plugin": "1.4.4",
    "@eslint/js": "10.0.1",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.64.1",
    "@types/node": "^24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "linkinator": "8.1.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5",
    "wrangler": "4.151.1"
  }
}
